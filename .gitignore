# Your real secrets — never commit these. Copy the .example.json files instead.
config.json
profiles.json
provision.json
provision.defaults.json
*-provision.json

# Downloaded/decompressed OS images (multi-GB, machine-local cache)
rpi-images/

# Runtime logs
/tmp/flash-*.log
*.log

# .deb build output (regenerate with packaging/build-deb.sh)
packaging/build/
packaging/dist/

# .rpm build output (regenerate with packaging/build-rpm.sh)
packaging/rpm-build/
packaging/rpm-dist/

# makepkg build output
packaging/arch-dist/
packaging/arch/*.pkg.tar.*
packaging/arch/src/
packaging/arch/pkg/

# Python
__pycache__/
*.pyc

# Editor/OS cruft
.DS_Store
*.swp

# Tool-specific state directories some environments generate here
.omc/
.impeccable/
.gstack/
