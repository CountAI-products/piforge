#!/usr/bin/env python3
#
# PiForge desktop app — installed as /usr/bin/piforge.
#
# A real native window (GTK3 + WebKit2), not a browser dressed up in
# "--app=" mode: own title bar, own taskbar/dock entry and icon, no
# address bar, no tabs, no browser context menu. This is what makes it
# feel like an installed system app (Raspberry Pi Imager, GParted, etc.)
# instead of "a website you navigated to". Depends only on apt packages
# (python3-gi + webkit2gtk), never pip.
#
# Flashing needs root (raw block-device writes), so this starts server.py
# via pkexec — a native graphical password prompt — the first time it's
# needed, then reuses that running server on every later launch.
import subprocess
import sys
import time
import urllib.error
import urllib.request

import gi
gi.require_version("Gtk", "3.0")
try:
    gi.require_version("WebKit2", "4.1")
    from gi.repository import WebKit2
except ValueError:
    gi.require_version("WebKit2", "4.0")
    from gi.repository import WebKit2
from gi.repository import Gtk, Gdk, GLib, Gio

APP_ID = "io.github.gokul-hastrophil.piforge"
INSTALL_DIR = "/opt/piforge"
ICON_PATH = "/usr/share/icons/hicolor/scalable/apps/piforge.svg"
PORT = 47823
URL = f"http://127.0.0.1:{PORT}/"
LOG_PATH = "/tmp/piforge-server.log"


def server_up():
    try:
        urllib.request.urlopen(URL, timeout=1.5)
        return True
    except (urllib.error.URLError, OSError):
        return False


def server_busy():
    """True if any card is mid-flash — used to guard against closing the
    window (and killing the server under it) while a card is writing."""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/api/devices", timeout=2) as r:
            import json
            data = json.load(r)
            return data.get("flashing", False) or data.get("provisioning", False)
    except Exception:
        return False


def start_server():
    """Returns True if we're the one who started it (so we know it's ours
    to stop later); False if it was already running."""
    if server_up():
        return False
    with open(LOG_PATH, "w") as log:
        # Invoke the dedicated root-helper wrapper (not "pkexec python3
        # server.py" directly) so polkit matches this to the
        # io.github.gokul-hastrophil.piforge.run-server action and shows
        # a branded "PiForge needs root to flash SD cards" prompt instead
        # of a generic "run /usr/bin/python3 ..." one.
        subprocess.Popen(["pkexec", f"{INSTALL_DIR}/piforge-server-root"],
                         stdout=log, stderr=subprocess.STDOUT)
    for _ in range(40):
        if server_up():
            return True
        time.sleep(0.5)
    show_error(f"PiForge server didn't start — see {LOG_PATH}")
    sys.exit(1)


def show_error(message):
    dialog = Gtk.MessageDialog(
        transient_for=None, flags=0, message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.OK, text="PiForge")
    dialog.format_secondary_text(message)
    dialog.run()
    dialog.destroy()


class PiForgeWindow(Gtk.ApplicationWindow):
    def __init__(self, app, we_started_server):
        super().__init__(application=app, title="PiForge")
        self.we_started_server = we_started_server
        self.set_default_size(1320, 900)
        try:
            self.set_icon_from_file(ICON_PATH)
        except GLib.Error:
            pass  # icon theme lookup can be flaky in some minimal setups; non-fatal

        self.webview = WebKit2.WebView()
        settings = self.webview.get_settings()
        settings.set_enable_developer_extras(False)
        self.webview.load_uri(URL)
        # A right-click "Inspect Element" browser menu would break the
        # native-app illusion — suppress it.
        self.webview.connect("context-menu", lambda *a: True)
        self.add(self.webview)

        self.connect("delete-event", self.on_close)

    def on_close(self, *_args):
        if server_busy():
            dialog = Gtk.MessageDialog(
                transient_for=self, flags=0, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.YES_NO,
                text="A flash or full install is in progress")
            dialog.format_secondary_text(
                "Closing PiForge now will stop the server and leave any card "
                "that's being written incomplete. Close anyway?")
            response = dialog.run()
            dialog.destroy()
            if response != Gtk.ResponseType.YES:
                return True  # cancel the close

        if self.we_started_server:
            subprocess.run(["pkill", "-f", f"{INSTALL_DIR}/server.py"])
        return False


class PiForgeApp(Gtk.Application):
    """Single-instance GTK application. Launching `piforge` again while a
    window is already open re-presents that window instead of starting a
    second process — previously each launch was an independent process
    with its own we_started_server flag, so whichever one happened to
    close first could kill the server out from under any other still-open
    window (see issue #3). With a single shared process there's only ever
    one we_started_server flag and one server lifecycle to reason about."""

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.window = None

    def do_activate(self):
        if self.window is None:
            we_started_server = start_server()
            self.window = PiForgeWindow(self, we_started_server)
            self.window.show_all()
        else:
            self.window.present()


def main():
    app = PiForgeApp()
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
